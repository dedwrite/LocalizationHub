import {
  getRecentProjectDisplayPath,
  type RecentProject,
} from './recentProjects'

import './RecentProjectsPanel.css'

type RecentProjectsProps = {
  projects:
    RecentProject[]

  onOpen:
    (
      project:
        RecentProject,
    ) => void | Promise<void>

  onRemove:
    (
      project:
        RecentProject,
    ) => void

  onClear:
    () => void
}

function RecentProjects({
  projects,
  onOpen,
  onRemove,
  onClear,
}: RecentProjectsProps) {
  if (
    projects.length ===
    0
  ) {
    return null
  }

  return (
    <section className="recent-projects">
      <div className="recent-projects-header">
        <div>
          <span className="recent-projects-eyebrow">
            Recent
          </span>

          <h2>
            Projects
          </h2>
        </div>

        <button
          className="recent-projects-clear"
          type="button"
          onClick={
            onClear
          }
          title="Clear recent projects"
        >
          Clear
        </button>
      </div>

      <div className="recent-projects-list">
        {
          projects.map(
            (project) => {
              const displayPath =
                getRecentProjectDisplayPath(
                  project.path,
                )

              return (
                <div
                  className="recent-project-row"
                  key={
                    project.path
                  }
                >
                  <button
                    className="recent-project-open"
                    type="button"
                    onClick={() => {
                      void onOpen(
                        project,
                      )
                    }}
                    title={
                      project.path
                    }
                  >
                    <span className="recent-project-icon">
                      LH
                    </span>

                    <span className="recent-project-info">
                      <strong>
                        {
                          project.sourceFileName
                        }
                      </strong>

                      <span>
                        {
                          displayPath
                        }
                      </span>
                    </span>

                    <span
                      className="recent-project-arrow"
                      aria-hidden="true"
                    >
                      â†’
                    </span>
                  </button>

                  <button
                    className="recent-project-remove"
                    type="button"
                    onClick={() =>
                      onRemove(
                        project,
                      )
                    }
                    title="Remove from recent projects"
                    aria-label={
                      `Remove ${project.sourceFileName} from recent projects`
                    }
                  >
                    Ã—
                  </button>
                </div>
              )
            },
          )
        }
      </div>
    </section>
  )
}

export default RecentProjects

