# Public production configuration for the LocalizationHub desktop client.
#
# These are PUBLIC service endpoints (not secrets). They are embedded into the
# desktop client at build time so a released installer is Cloud-enabled without
# any manual environment setup.
#
# Never place secrets, credentials, tokens, or API keys in this file.

# Cloud API (auth, Cloud Projects, workflow) — same service that hosts the web app.
VITE_CLOUD_API_URL=https://localizationhub.app

# Real-time collaboration relay (WebSocket).
VITE_COLLABORATION_SERVER_URL=wss://localizationhub-relay.onrender.com
